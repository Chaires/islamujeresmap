Options -Indexes
DirectoryIndex index.html index.php
<FilesMatch "\.(sqlite|json|md|example\.php)$">
  Require all denied
</FilesMatch>

# Modo sin conexión: el navegador siempre revisa si hay versión nueva de sw.js
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
